# Copy to .env for local development. Never commit the real .env file.
GEMINI_API_KEY=your-key-from-google-ai-studio
GEMINI_MODEL=gemini-3.5-flash-lite
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
# Set MOCK_GEMINI=1 to run the app without calling Gemini (offline testing only)
MOCK_GEMINI=0
# After the first Cloud Run deploy, set this to your service URL, e.g. https://ekaam-ai-xxxx.a.run.app
CSRF_TRUSTED_ORIGINS=
